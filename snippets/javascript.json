{
  "console.info": {
    "prefix": "info",
    "body": ["console.info(`${1:var}: '\\${${1:var}}'`);$0"],
  },
  "console.info.obj": {
    "prefix": "o.info",
    "body": ["console.info(`${1:var}:`, ${1:var});$0"],
  },
  "console.debug": {
    "prefix": "debug",
    "body": ["console.debug(`${1:var}: '\\${${1:var}}'`);$0"],
  },
  "console.log": {
    "prefix": "log",
    "body": ["console.log(`${1:var}: '\\${${1:var}}'`);$0"],
  },
  "Make a class": {
    "prefix": "class",
    "body": [
      "export class ${1:ClassName} {",
      "  constructor(${2:args}) {",
      "    $0",
      "  }",
      "}"
    ],
  },
  "Create an arrow function": {
    "prefix": "ar",
    "body": [
      "(${2:args}) => { $0 }"
    ],
  },
  "Create a function": {
    "prefix": "fn",
    "body": [
      "function ${1:funcName}(${2:args}) {",
      "  $0",
      "}"
    ],
  },
  "document": {
    "prefix": "doc",
    "body": ["document"]
  },
  "html": { "body":["/* html */`$0`;"] },
  "css" : { "body":["/* css */`$0`;"] },
  "return": {
    "prefix": "rt",
    "body": ["return $0"],
    "description": "return"
  },
}
