{
    "Function fn ...": {
        "prefix": "f",
        "description": "Creates a funtion placceholder",
        "body": [
            "fn ${1:func}($2) ${3:-> } {",
            "    $0",
            "    todo!()",
            "}",
        ]
    },
    "Result<_,_>": {
        "prefix": "r",
        "description": "Create a Result<_, _>",
        "body": ["Result<$1, $2>$0"]
    },
    "Option<_>": {
        "prefix": "o",
        "description": "Create a Option<_>",
        "body": ["Option<$1>$0"]
    },
    "#[derive(_)]": {
        "prefix": "d",
        "body": [
          "#[derive($1)]$0",
        ]
    },
    "Clone - Debug": {
        "prefix": "cd",
        "body": ["Clone, Debug"]
    },
    "New": {
        "prefix": "new",
        "body": [
          "pub fn new() -> Self {",
          "    Self { $0 }",
          "}",
        ]
    },
    "test": {
        "prefix": "ts",
        "body": [
          "#[test]",
          "fn ${1:func}() -> Result<(), Report> {",
          "    $0",
          "    Ok(())",
          "}",
        ]
    },
}
